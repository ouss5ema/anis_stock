# Same content as .env.production.example (kept for older docs).
COMPOSE_PROJECT_NAME=stock-management
NODE_ENV=production
PORT=3000
API_HOST_BIND=127.0.0.1
API_HOST_PORT=3100
POSTGRES_USER=stockapp
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=stock_management
POSTGRES_DATA_DIR=/opt/stock-management/data/postgres
DATABASE_URL=postgresql://stockapp:replace-with-a-strong-db-password@postgres:5432/stock_management?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://api-stock.example.com
ALLOW_REGISTER=false
BACKUP_DIR=/opt/stock-management/backups
POSTGRES_CONTAINER=stockapp_postgres
